<Window x:Class="RoboCopy_GUI_Kr.Agent.AgentErrorWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RoboCopy_GUI_Kr.Agent"
        Title="{StaticResource AgentErrorsTitle}" Width="980" Height="520" MinWidth="760" MinHeight="400"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="{StaticResource AgentErrorsInstruction}" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" />
        <DataGrid x:Name="ErrorsDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{StaticResource GracefulShutdownAndRetry}" Click="GracefulRetry_Click" />
                    <MenuItem x:Name="ForceTerminateMenuItem" Header="{StaticResource ForceTerminate}" Click="ForceTerminate_Click" Visibility="Collapsed" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{StaticResource ErrorCode}" Binding="{Binding ErrorCode}" Width="75">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding ErrorDescription}" /></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{StaticResource ErrorType}" Binding="{Binding CategoryText}" Width="120" />
                <DataGridTemplateColumn Header="{StaticResource SourceFolder}" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:AgentPathTextBlock FullPath="{Binding Item.SourcePath}" Padding="4,0" HorizontalAlignment="Stretch" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{StaticResource DestinationFolder}" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:AgentPathTextBlock FullPath="{Binding Item.DestinationPath}" Padding="4,0" HorizontalAlignment="Stretch" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="{StaticResource Occurrences}" Binding="{Binding Item.Occurrences}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="4" HorizontalAlignment="Right">
            <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="4,3" />
                </Style>
            </WrapPanel.Resources>
            <Button Content="{StaticResource RetryTask}" Click="Retry_Click" />
            <Button Content="{StaticResource RetryAsAdministrator}" Click="ElevatedRetry_Click" />
            <Button Content="{StaticResource CheckLockingProcesses}" Click="CheckLocks_Click" />
            <Button Content="{StaticResource GracefulShutdownAndRetry}" Click="GracefulRetry_Click" />
            <Button x:Name="ForceTerminateButton" Content="{StaticResource ForceTerminate}" Click="ForceTerminate_Click"
                    Visibility="Collapsed" Style="{StaticResource DangerButton}" />
            <Button Content="{StaticResource Close}" Click="Close_Click" />
        </WrapPanel>
    </Grid>
</Window>
