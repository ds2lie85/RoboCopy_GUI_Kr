<Window x:Class="RoboCopy_GUI_Kr.Agent.AgentNotificationListWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource AgentNotificationListTitle}" Width="860" Height="520"
        MinWidth="680" MinHeight="380" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{StaticResource AgentNotificationListTitle}" Style="{StaticResource PageTitle}" />
            <TextBlock Margin="0,6,0,0" Text="{StaticResource AgentNotificationListDescription}" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" />
        </StackPanel>
        <DataGrid x:Name="NotificationDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" MouseDoubleClick="NotificationDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{StaticResource AgentNotificationTime}" Binding="{Binding CompletedAt}" Width="170" />
                <DataGridTextColumn Header="{StaticResource AgentNotificationTarget}" Binding="{Binding Target}" Width="150" />
                <DataGridTextColumn Header="{StaticResource AgentNotificationSummary}" Binding="{Binding Summary}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="EmptyTextBlock" Grid.Row="2" Text="{StaticResource AgentNotificationEmpty}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
        <Button Grid.Row="4" Content="{StaticResource Close}" HorizontalAlignment="Right" IsCancel="True" Click="Close_Click" />
    </Grid>
</Window>
