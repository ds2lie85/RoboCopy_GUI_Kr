<Window x:Class="RoboCopy_GUI_Kr.Agent.AgentNotificationDetailWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RoboCopy_GUI_Kr.Agent"
        Title="{StaticResource AgentNotificationDetailTitle}" Width="780" Height="520"
        MinWidth="620" MinHeight="360" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="SummaryTextBlock" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
        <DataGrid x:Name="ChangeDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  PreviewMouseRightButtonDown="ChangeDataGrid_PreviewMouseRightButtonDown">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{StaticResource AgentNotificationOpen}" Click="Open_Click" />
                    <MenuItem Header="{StaticResource AgentNotificationOpenLocation}" Click="OpenLocation_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{StaticResource AgentNotificationAction}" Binding="{Binding Action}" Width="100" />
                <DataGridTemplateColumn Header="{StaticResource AgentNotificationPath}" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:AgentPathTextBlock FullPath="{Binding RelativePath}" Padding="4,0" HorizontalAlignment="Stretch" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="4" Content="{StaticResource Close}" HorizontalAlignment="Right"
                IsCancel="True" Click="Close_Click" />
    </Grid>
</Window>
