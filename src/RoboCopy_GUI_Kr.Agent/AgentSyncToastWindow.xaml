<Window x:Class="RoboCopy_GUI_Kr.Agent.AgentSyncToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="410" Height="116" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Background="Transparent" AllowsTransparency="True">
    <Border Background="#F21B1B1B" BorderBrush="#2F6FEB" BorderThickness="0,0,0,4"
            Padding="16" CornerRadius="6" MouseLeftButtonUp="Toast_MouseLeftButtonUp">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="18" Background="#1685E6" VerticalAlignment="Center">
                <TextBlock Text="i" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{StaticResource AgentNotificationSummary}" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                <TextBlock x:Name="MessageTextBlock" Margin="0,5,0,0" Foreground="#D8D8D8" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
