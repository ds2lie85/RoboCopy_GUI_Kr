<Window x:Class="RoboCopy_GUI_Kr.ForceTerminateWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="{StaticResource ForceTerminateTitle}" Width="600" Height="290"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource DangerWindowBrush}">
    <Border Margin="14" Background="White" BorderBrush="#B71C1C" BorderThickness="1.5" CornerRadius="16">
        <Grid Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="26" VerticalAlignment="Top" Background="{StaticResource DangerSoftBrush}">
                    <Viewbox Width="28" Height="28">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,2.5 L22.5,20.5 L1.5,20.5 Z" Fill="{StaticResource DangerBrush}"
                                  Stroke="{StaticResource DangerBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                            <Path Data="M12,9 L12,14.5" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Canvas.Left="11" Canvas.Top="16.6" Width="2" Height="2" Fill="White" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <TextBlock Text="{StaticResource ForceTerminateTitle}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,12,0,0" Text="{StaticResource ForceTerminateWarning}"
                               FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DangerDeepBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{StaticResource Cancel}" IsCancel="True" MinWidth="88" />
                <Button Content="{StaticResource ForceTerminateProceed}" Click="Proceed_Click"
                        Style="{StaticResource DangerButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
