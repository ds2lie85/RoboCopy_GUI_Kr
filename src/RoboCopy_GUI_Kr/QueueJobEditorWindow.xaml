<Window x:Class="RoboCopy_GUI_Kr.QueueJobEditorWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource QueueJobEditorTitle}"
        Width="720"
        Height="275"
        MinWidth="620"
        MinHeight="260"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="90" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{StaticResource SourceFolder}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="SourceTextBox" Grid.Row="0" Grid.Column="1" />
        <Button Grid.Row="0" Grid.Column="2" Content="{StaticResource Browse}" Click="BrowseSource_Click" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{StaticResource DestinationFolder}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="DestinationTextBox" Grid.Row="2" Grid.Column="1" />
        <Button Grid.Row="2" Grid.Column="2" Content="{StaticResource Browse}" Click="BrowseDestination_Click" />

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="{StaticResource QueueJobOptionsNotice}"
                   Foreground="{StaticResource SubtleTextBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{StaticResource Save}" IsDefault="True" Click="Save_Click" />
            <Button Content="{StaticResource Cancel}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
