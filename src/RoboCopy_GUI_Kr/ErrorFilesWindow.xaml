<Window x:Class="RoboCopy_GUI_Kr.ErrorFilesWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RoboCopy_GUI_Kr"
        Title="{StaticResource ErrorFilesTitle}"
        Width="1120" Height="520" MinWidth="820" MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{StaticResource ErrorFilesInstruction}" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="DiagnosisTextBlock" Text="{StaticResource SelfOverwriteGuidance}"
                       TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
        </StackPanel>
        <DataGrid x:Name="ErrorDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="None">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{StaticResource RetrySelected}" Click="RetrySelected_Click" />
                    <MenuItem Header="{StaticResource RetrySelectedAsAdministrator}" Click="RetrySelectedAsAdministrator_Click" />
                    <MenuItem Header="{StaticResource CheckLockingProcesses}" Click="CheckLockingProcesses_Click" />
                    <Separator />
                    <MenuItem Header="{StaticResource OpenSourceLocation}" Click="OpenSourceLocation_Click" />
                    <MenuItem Header="{StaticResource OpenDestinationLocation}" Click="OpenDestinationLocation_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{StaticResource RetryStatus}" Binding="{Binding RetryStateText}" Width="105" />
                <DataGridTextColumn Header="{StaticResource ErrorCategory}" Binding="{Binding StatusText}" Width="120" />
                <DataGridTemplateColumn Header="{StaticResource ErrorCode}" Width="75">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ErrorCode}" ToolTip="{Binding ErrorCodeToolTip}"
                                       VerticalAlignment="Center" Padding="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{StaticResource SourceLocation}" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <local:PathTextBlock FullPath="{Binding SourcePath}" Padding="4,0"
                                                 HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{StaticResource DestinationLocation}" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <local:PathTextBlock FullPath="{Binding DestinationPath}" Padding="4,0"
                                                 HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{StaticResource RetryOccurrences}" Binding="{Binding Occurrences}" Width="75" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryTextBlock" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{StaticResource RetrySelected}" Click="RetrySelected_Click" />
                <Button Content="{StaticResource RetrySelectedAsAdministrator}" Click="RetrySelectedAsAdministrator_Click" />
                <Button Content="{StaticResource CheckLockingProcesses}" Click="CheckLockingProcesses_Click" />
                <Button Content="{StaticResource Close}" IsCancel="True" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
