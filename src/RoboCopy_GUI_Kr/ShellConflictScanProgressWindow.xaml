<Window x:Class="RoboCopy_GUI_Kr.ShellConflictScanProgressWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource ShellConflictScanTitle}"
        Width="440" Height="170" ResizeMode="NoResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{StaticResource ShellConflictScanHeading}" Style="{StaticResource PageTitle}" />
        <ProgressBar x:Name="ScanProgressBar" Grid.Row="2" Height="20" IsIndeterminate="True" />
        <TextBlock x:Name="ScanStatusTextBlock" Grid.Row="4" Foreground="{StaticResource SubtleTextBrush}" />
    </Grid>
</Window>
