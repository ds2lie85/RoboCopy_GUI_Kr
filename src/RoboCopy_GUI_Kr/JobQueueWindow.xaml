<Window x:Class="RoboCopy_GUI_Kr.JobQueueWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RoboCopy_GUI_Kr"
        Title="{StaticResource JobList}"
        Width="900"
        Height="470"
        MinWidth="700"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{StaticResource JobQueueInstruction}" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />

        <DataGrid x:Name="QueueDataGrid" Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  PreviewMouseLeftButtonDown="QueueDataGrid_PreviewMouseLeftButtonDown"
                  PreviewMouseLeftButtonUp="QueueDataGrid_PreviewMouseLeftButtonUp"
                  PreviewMouseMove="QueueDataGrid_PreviewMouseMove"
                  PreviewMouseRightButtonDown="QueueDataGrid_PreviewMouseRightButtonDown">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{StaticResource Add}" Click="Add_Click" />
                    <MenuItem Header="{StaticResource EditSelected}" Click="Edit_Click" />
                    <Separator />
                    <MenuItem Header="{StaticResource RemoveSelected}" Click="Remove_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{StaticResource QueueOrder}" Binding="{Binding Order}" Width="60" />
                <DataGridTextColumn Header="{StaticResource QueueState}" Binding="{Binding State}" Width="105" />
                <DataGridTemplateColumn Header="{StaticResource SourceFolder}" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:PathTextBlock FullPath="{Binding SourceDirectory}" Padding="4,0" HorizontalAlignment="Stretch" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{StaticResource DestinationFolder}" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:PathTextBlock FullPath="{Binding DestinationDirectory}" Padding="4,0" HorizontalAlignment="Stretch" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="QueueSummaryTextBlock" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{StaticResource Add}" Click="Add_Click" />
                <Button Content="{StaticResource EditSelected}" Click="Edit_Click" />
                <Button Content="{StaticResource RemoveSelected}" Click="Remove_Click" />
                <Button Content="{StaticResource Close}" IsCancel="True" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
