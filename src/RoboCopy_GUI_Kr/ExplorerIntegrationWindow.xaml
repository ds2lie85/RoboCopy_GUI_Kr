<Window x:Class="RoboCopy_GUI_Kr.ExplorerIntegrationWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource ExplorerIntegration}" Width="620" Height="300"
        MinWidth="560" MinHeight="280" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{StaticResource ExplorerIntegrationDescription}" TextWrapping="Wrap" />
        <Border Grid.Row="2" Padding="16" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="{StaticResource ExplorerIntegrationStatusLabel}" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusTextBlock" Margin="0,6,0,0" />
                <TextBlock Margin="0,12,0,0" Foreground="{StaticResource SubtleTextBrush}"
                           Text="{StaticResource ExplorerIntegrationWindows11Note}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{StaticResource Register}" Click="Register_Click" />
            <Button Content="{StaticResource Unregister}" Click="Unregister_Click" />
            <Button Content="{StaticResource Close}" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
