<Window x:Class="RoboCopy_GUI_Kr.LogWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource ExecutionLog}"
        Width="960"
        Height="680"
        MinWidth="620"
        MinHeight="360"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="LogTextBox"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="{StaticResource MonoFontFamily}"
                 FontSize="12"
                 Background="{StaticResource PanelBrush}"
                 Foreground="{StaticResource TextBrush}" Padding="14,10" />
        <Button Grid.Row="2" Content="{StaticResource Close}" HorizontalAlignment="Right" Click="Close_Click" />
    </Grid>
</Window>
