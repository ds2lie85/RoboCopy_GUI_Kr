<Window x:Class="RoboCopy_GUI_Kr.ShellOverwriteSelectionWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RoboCopy_GUI_Kr"
        Title="{StaticResource ShellOverwriteSelectionTitle}"
        Width="1080" Height="650" MinWidth="860" MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{StaticResource ShellOverwriteSelectionHeading}" Style="{StaticResource PageTitle}" />
            <TextBlock Margin="0,7,0,0" Text="{StaticResource ShellOverwriteSelectionInstruction}"
                       TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" />
        </StackPanel>
        <ListBox x:Name="OverwriteGroupsList" Grid.Row="2" ItemsSource="{Binding Rows}"
                 BorderThickness="0" Padding="0" Background="Transparent"
                 ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Padding="14" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Background="{StaticResource PanelBrush}" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold" />
                                <local:PathTextBlock Margin="0,2,0,8" FullPath="{Binding DestinationPath}"
                                                     Foreground="{StaticResource SubtleTextBrush}" />
                                <DataGrid ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                                          GridLinesVisibility="All" MaxHeight="260">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Resources>
                                        <Style x:Key="RightAlignedCell" TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right" />
                                            <Setter Property="Padding" Value="4,0" />
                                        </Style>
                                        <Style x:Key="AddressCell" TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding FullAddress}" />
                                            <Setter Property="Padding" Value="4,0" />
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{StaticResource FileName}" Binding="{Binding FileName}" Width="190" />
                                        <DataGridTextColumn Header="{StaticResource Size}" Binding="{Binding SizeText}" Width="100"
                                                            ElementStyle="{StaticResource RightAlignedCell}" />
                                        <DataGridTextColumn Header="{StaticResource ModifiedDate}" Binding="{Binding ModifiedAtText}" Width="160" />
                                        <DataGridTextColumn Header="{StaticResource CreatedDate}" Binding="{Binding CreatedAtText}" Width="160" />
                                        <DataGridTemplateColumn Header="{StaticResource Address}" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:PathTextBlock FullPath="{Binding FullAddress}" Padding="4,0" HorizontalAlignment="Stretch" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{StaticResource Cancel}" IsCancel="True" />
            <Button Content="{StaticResource ApplySelection}" IsDefault="True" Click="Apply_Click" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
