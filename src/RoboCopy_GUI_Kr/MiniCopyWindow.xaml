<Window x:Class="RoboCopy_GUI_Kr.MiniCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource MiniUiTitle}" Width="460" Height="270"
        MinWidth="420" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="White" FontFamily="{StaticResource AppFontFamily}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="StateBanner" Background="{StaticResource AccentBrush}" ClipToBounds="True">
            <Grid>
                <Viewbox Width="250" Height="58" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Stretch="Fill" Opacity="0.28" IsHitTestVisible="False">
                    <Canvas Width="220" Height="38">
                        <Path Fill="White" Data="M0,32 H6 V38 H0 Z M8,32 H14 V38 H8 Z M8,24 H14 V30 H8 Z M16,32 H22 V38 H16 Z M16,24 H22 V30 H16 Z M16,16 H22 V22 H16 Z M24,32 H30 V38 H24 Z M32,32 H38 V38 H32 Z M40,32 H46 V38 H40 Z M40,24 H46 V30 H40 Z M48,32 H54 V38 H48 Z M48,24 H54 V30 H48 Z M48,16 H54 V22 H48 Z M48,8 H54 V14 H48 Z M56,32 H62 V38 H56 Z M56,24 H62 V30 H56 Z M64,32 H70 V38 H64 Z M72,32 H78 V38 H72 Z M80,32 H86 V38 H80 Z M80,24 H86 V30 H80 Z M88,32 H94 V38 H88 Z M88,24 H94 V30 H88 Z M88,16 H94 V22 H88 Z M96,32 H102 V38 H96 Z M96,24 H102 V30 H96 Z M104,32 H110 V38 H104 Z M112,32 H118 V38 H112 Z M120,32 H126 V38 H120 Z M120,24 H126 V30 H120 Z M128,32 H134 V38 H128 Z M128,24 H134 V30 H128 Z M128,16 H134 V22 H128 Z M128,8 H134 V14 H128 Z M136,32 H142 V38 H136 Z M136,24 H142 V30 H136 Z M144,32 H150 V38 H144 Z M152,32 H158 V38 H152 Z M160,32 H166 V38 H160 Z M160,24 H166 V30 H160 Z M168,32 H174 V38 H168 Z M168,24 H174 V30 H168 Z M168,16 H174 V22 H168 Z M176,32 H182 V38 H176 Z M176,24 H182 V30 H176 Z M176,16 H182 V22 H176 Z M176,8 H182 V14 H176 Z M184,32 H190 V38 H184 Z M184,24 H190 V30 H184 Z M184,16 H190 V22 H184 Z M192,32 H198 V38 H192 Z M192,24 H198 V30 H192 Z M192,16 H198 V22 H192 Z M192,8 H198 V14 H192 Z M200,32 H206 V38 H200 Z M200,24 H206 V30 H200 Z M200,16 H206 V22 H200 Z M200,8 H206 V14 H200 Z M208,32 H214 V38 H208 Z M208,24 H214 V30 H208 Z M208,16 H214 V22 H208 Z M208,8 H214 V14 H208 Z M216,32 H220 V38 H216 Z M216,24 H220 V30 H216 Z M216,16 H220 V22 H216 Z M216,8 H220 V14 H216 Z M216,0 H220 V6 H216 Z" />
                    </Canvas>
                </Viewbox>
                <TextBlock x:Name="StateTextBlock" Margin="16,0" Foreground="White" FontSize="15"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="16,12,16,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="RouteTextBlock" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button x:Name="PauseResumeButton" Width="46" Height="34" Click="PauseResume_Click" />
                <Button Content="×" Width="46" Height="34" Margin="6,0,0,0" FontSize="18" Click="Stop_Click" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ProgressStatusTextBlock" Grid.Row="2" Margin="16,0,16,8" FontSize="16" />
        <ProgressBar x:Name="MiniProgressBar" Grid.Row="3" Height="16" Margin="16,0,16,12" Minimum="0" Maximum="100" />
        <Border Grid.Row="4" MinHeight="52" BorderBrush="#D8DEE8" BorderThickness="0,1,0,0" Background="#FAFBFD">
            <Button Content="{StaticResource MiniUiAdvancedSettings}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="12,7" Padding="12,5" Click="AdvancedSettings_Click" />
        </Border>
    </Grid>
</Window>
