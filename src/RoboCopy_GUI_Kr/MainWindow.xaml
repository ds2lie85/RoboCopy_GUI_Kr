                        <Path x:Name="DigitalRhythmEndingRise" Fill="White" Data="M612,47 H619 V54 H612 Z M621,47 H628 V54 H621 Z M621,38 H628 V45 H621 Z M630,47 H637 V54 H630 Z M630,38 H637 V45 H630 Z M630,29 H637 V36 H630 Z M639,47 H646 V54 H639 Z M639,38 H646 V45 H639 Z M639,29 H646 V36 H639 Z M639,20 H646 V27 H639 Z M648,47 H655 V54 H648 Z M648,38 H655 V45 H648 Z M648,29 H655 V36 H648 Z M648,20 H655 V27 H648 Z M648,11 H655 V18 H648 Z M657,47 H664 V54 H657 Z M657,38 H664 V45 H657 Z M657,29 H664 V36 H657 Z M657,20 H664 V27 H657 Z M657,11 H664 V18 H657 Z M657,2 H664 V9 H657 Z M666,47 H673 V54 H666 Z M666,38 H673 V45 H666 Z M666,29 H673 V36 H666 Z M666,20 H673 V27 H666 Z M666,11 H673 V18 H666 Z M666,2 H673 V9 H666 Z" />
                    </Canvas>
                </Viewbox>
                <Border Width="46" Height="46" CornerRadius="14" Background="{StaticResource AccentGradientBrush}"
                        VerticalAlignment="Center">
                    <Viewbox Width="26" Height="26">
                        <Canvas Width="28" Height="28">
                            <Path Data="M5,9 L22,9 M17.5,4.5 L22,9 L17.5,13.5" Stroke="White" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Path Data="M23,19 L6,19 M10.5,14.5 L6,19 L10.5,23.5" Stroke="White" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0.85" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{StaticResource AppTitle}" Foreground="#102A56"
                               FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{StaticResource HeaderSubtitle}" Margin="0,3,0,0"
                               Foreground="#3B5F8C" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button x:Name="MiniUiButton" Content="{StaticResource MiniUi}" Style="{StaticResource GhostButton}"
                            Foreground="White" Background="#B31D4ED8" BorderBrush="#D9FFFFFF" FontWeight="SemiBold"
                            Click="MiniUi_Click" />
                    <Button x:Name="ExplorerIntegrationButton" Content="{StaticResource ExplorerIntegration}"
                            Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Foreground="White" Background="#B31D4ED8" BorderBrush="#D9FFFFFF" FontWeight="SemiBold"
                            Click="ExplorerIntegration_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 작업 설정 카드 -->
        <Border Grid.Row="1" Margin="16,16,16,8" Padding="20,18" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{StaticResource SourceFolder}" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="SourceTextBox" Grid.Row="0" Grid.Column="1" TextChanged="CopyPath_TextChanged" />
                <Button Grid.Row="0" Grid.Column="2" Content="{StaticResource Browse}" MinWidth="72" Margin="8,0,0,0" Click="BrowseSource_Click" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{StaticResource DestinationFolder}" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="DestinationTextBox" Grid.Row="2" Grid.Column="1" TextChanged="CopyPath_TextChanged" />
                <Button Grid.Row="2" Grid.Column="2" Content="{StaticResource Browse}" MinWidth="72" Margin="8,0,0,0" Click="BrowseDestination_Click" />

                <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{StaticResource OperationMode}" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="OperationComboBox" Grid.Column="1" SelectedIndex="0"
                              SelectionChanged="OperationComboBox_SelectionChanged">
                        <ComboBoxItem Content="{StaticResource CopyMode}" Tag="Copy" />
                        <ComboBoxItem Content="{StaticResource MoveMode}" Tag="Move" />
                        <ComboBoxItem Content="{StaticResource UpdateSyncMode}" Tag="UpdateSync"
                                      ToolTip="{StaticResource UpdateSyncModeTooltip}" />
                        <ComboBoxItem Content="{StaticResource ContinuousSyncMode}" Tag="ContinuousSync"
                                      ToolTip="{StaticResource ContinuousSyncModeTooltip}" />
                    </ComboBox>
                    <TextBlock Grid.Column="3" Text="{StaticResource Profile}" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                    <ComboBox x:Name="ProfileComboBox" Grid.Column="4" DisplayMemberPath="Name"
                              SelectionChanged="ProfileComboBox_SelectionChanged">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <EventSetter Event="PreviewMouseRightButtonDown"
                                            Handler="ProfileItem_PreviewMouseRightButtonDown" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{StaticResource RenameProfile}" Click="RenameProfile_Click" />
                                <MenuItem Header="{StaticResource DuplicateProfile}" Click="DuplicateProfile_Click" />
                                <Separator />
                                <MenuItem Header="{StaticResource DeleteProfile}" Click="DeleteProfile_Click" />
                            </ContextMenu>
                        </ComboBox.ContextMenu>
                    </ComboBox>
                    <Button x:Name="SaveProfileButton" Grid.Column="5" Content="{StaticResource SaveProfile}"
                            Margin="8,0,4,0" Click="SaveProfile_Click" />
                    <Button Grid.Column="6" Content="{StaticResource JobList}" Click="JobList_Click" />
                    <Button Grid.Column="7" Content="{StaticResource Exclusions}" Click="ConfigureExclusions_Click" />
                    <TextBlock x:Name="ExclusionSummaryTextBlock" Grid.Column="8" Margin="10,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource SubtleTextBrush}" Text="{StaticResource NoExclusions}" />
                </Grid>

                <GroupBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Header="{StaticResource PerformanceOptions}" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,10,0" Text="{StaticResource MultiThread}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="MultiThreadComboBox" Grid.Column="1" IsEditable="True" SelectedIndex="0"
                                  ToolTip="{StaticResource AutoMtTooltip}">
                            <ComboBoxItem x:Name="AutoMtComboBoxItem" Content="{StaticResource AutoMtInitial}" Tag="Auto" />
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="4" />
                            <ComboBoxItem Content="8" />
                            <ComboBoxItem Content="16" />
                            <ComboBoxItem Content="32" />
                            <ComboBoxItem Content="64" />
                            <ComboBoxItem Content="128" />
                        </ComboBox>
                        <Button x:Name="ReevaluateAutoMtButton" Grid.Column="2" Margin="0"
                                Content="{StaticResource ReevaluateAutoMt}"
                                ToolTip="{StaticResource ReevaluateAutoMtTooltip}"
                                Click="ReevaluateAutoMt_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{StaticResource MtBenchmarkHistory}"
                                              Click="OpenMtBenchmarkHistory_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Popup x:Name="MtBenchmarkHistoryHintPopup" Grid.Column="2"
                               PlacementTarget="{Binding ElementName=ReevaluateAutoMtButton}"
                               Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                            <Border Margin="0,6,0,0" Padding="12,8" CornerRadius="8"
                                    Background="#FFFBEA" BorderBrush="#F0D98A" BorderThickness="1">
                                <TextBlock Text="{StaticResource MtBenchmarkHistoryRightClickHint}" Foreground="{StaticResource TextBrush}" />
                            </Border>
                        </Popup>
                        <TextBlock Grid.Column="4" Margin="0,0,10,0" Text="{StaticResource RetryCount}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="RetryCountTextBox" Grid.Column="5" Text="3" HorizontalContentAlignment="Center" />
                        <TextBlock Grid.Column="7" Margin="0,0,10,0" Text="{StaticResource RetryWait}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="RetryWaitTextBox" Grid.Column="8" Text="5" HorizontalContentAlignment="Center" />
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Header="{StaticResource CopyOptions}" Padding="14,10">
                    <WrapPanel Orientation="Horizontal">
                        <CheckBox x:Name="RestartableCheckBox" Content="{StaticResource Restartable}" IsChecked="True"
                                  VerticalAlignment="Center" Margin="0,4,26,4" />
                        <CheckBox x:Name="IncludeEmptyDirectoriesCheckBox" Content="{StaticResource IncludeEmptyDirectories}"
                                  VerticalAlignment="Center" Margin="0,4,26,4" />
                        <CheckBox x:Name="ExcludeZeroByteFilesCheckBox" Content="{StaticResource ExcludeZeroByteFiles}"
                                  ToolTip="{StaticResource ExcludeZeroByteFilesTooltip}" VerticalAlignment="Center" Margin="0,4,26,4" />
                        <CheckBox x:Name="SaveLogCheckBox" Content="{StaticResource SaveLog}" IsChecked="True"
                                  VerticalAlignment="Center" Margin="0,4,26,4" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                            <TextBlock Text="{StaticResource SymbolicLinkHandling}" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <ComboBox x:Name="LinkPolicyComboBox" Width="160" SelectedIndex="0">
                                <ComboBoxItem Content="{StaticResource LinkExclude}" Tag="Exclude" />
                                <ComboBoxItem Content="{StaticResource LinkCopy}" Tag="CopyLinkItself" />
                                <ComboBoxItem Content="{StaticResource LinkFollow}" Tag="FollowTarget" />
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                </GroupBox>

                <Grid Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CommandPreviewTextBlock" Grid.Column="0" Margin="2,0,12,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTipService.ShowDuration="60000"
                               FontSize="12" Foreground="{StaticResource SubtleTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="ToolTip" Value="{x:Null}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="PreviewButton" Content="{StaticResource Analyze}" Click="Preview_Click" Visibility="Collapsed" />
                        <Button x:Name="StartButton" Content="{StaticResource StartCopy}" Click="Start_Click"
                                Style="{StaticResource PrimaryButton}" MinWidth="84" />
                        <Button x:Name="AddJobButton" Content="{StaticResource AddJob}" Click="AddJob_Click" />
                        <Button x:Name="PauseButton" Content="{StaticResource Pause}" IsEnabled="False"
                                Click="Pause_Click" ToolTip="{StaticResource PauseTooltip}" />
                        <Button x:Name="StopButton" Content="{StaticResource Stop}" Click="Stop_Click" IsEnabled="False" />
                        <Button Content="{StaticResource ViewLog}" Click="Log_Click" />
                        <Button x:Name="ErrorFilesButton" Content="{StaticResource ErrorFiles}" Click="ErrorFiles_Click" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 진행 상황 카드 -->
        <Border Grid.Row="2" Margin="16,8,16,14" Padding="20,16" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProgressLabelTextBlock" Text="{StaticResource ProgressCopy}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                    <Grid Grid.Column="1">
                        <ProgressBar x:Name="ProgressBar" Height="22" Minimum="0" Maximum="100" />
                        <TextBlock x:Name="ProgressTextBlock" Text="0%" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                    </Grid>
                </Grid>
                <TextBlock x:Name="PhaseNoticeTextBlock" Grid.Row="2" Margin="0,8,0,8"
                           FontSize="18" FontWeight="SemiBold" TextAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />
                <Grid Grid.Row="4" Margin="0,8,0,0">
                <DataGrid x:Name="FileProgressDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          SelectionMode="Single"
                          RowHeight="36"
                          ColumnHeaderHeight="36"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{StaticResource FileName}" Width="2*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FileName}" ToolTip="{Binding SourcePath}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{StaticResource OpenSourceLocation}"
                                                          CommandParameter="{Binding SourcePath}"
                                                          Click="OpenLocation_Click" />
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{StaticResource Progress}" Width="160">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Width="132" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                     Height="16" Foreground="{StaticResource SuccessBrush}"
                                                     Background="{StaticResource ProgressTrackBrush}"
                                                     SnapsToDevicePixels="True">
                                            <ProgressBar.Template>
                                                <ControlTemplate TargetType="{x:Type ProgressBar}">
                                                    <Border Background="{TemplateBinding Background}" ClipToBounds="True"
                                                            SnapsToDevicePixels="True">
                                                        <Grid x:Name="PART_Track">
                                                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                                    Background="{TemplateBinding Foreground}"
                                                                    SnapsToDevicePixels="True" />
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </ProgressBar.Template>
                                        </ProgressBar>
                                        <TextBlock Text="{Binding Percent, StringFormat={}{0:F0}%}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{StaticResource DestinationLocation}" Width="3*" MinWidth="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <local:PathTextBlock FullPath="{Binding DestinationPath}" VerticalAlignment="Center">
                                        <local:PathTextBlock.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{StaticResource OpenDestinationLocation}"
                                                          CommandParameter="{Binding DestinationPath}"
                                                          Click="OpenLocation_Click" />
                                            </ContextMenu>
                                        </local:PathTextBlock.ContextMenu>
                                    </local:PathTextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid x:Name="CopySummaryPanel" Visibility="Collapsed" Margin="10,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="CopySummaryDataGrid" Grid.Row="0" Height="128"
                              AutoGenerateColumns="False" IsReadOnly="True" IsHitTestVisible="False"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                              BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                              AlternatingRowBackground="Transparent" RowHeight="30" MinRowHeight="30" ColumnHeaderHeight="34">
                        <DataGrid.Resources>
                            <Style x:Key="SummaryValueText" TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="6,0" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding Label}" Width="110" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="{StaticResource SummaryTotal}" Binding="{Binding Total}" Width="*" ElementStyle="{StaticResource SummaryValueText}" />
                            <DataGridTextColumn Header="{StaticResource SummaryCopied}" Binding="{Binding Copied}" Width="*" ElementStyle="{StaticResource SummaryValueText}" />
                            <DataGridTextColumn Header="{StaticResource SummarySkipped}" Binding="{Binding Skipped}" Width="*" ElementStyle="{StaticResource SummaryValueText}" />
                            <DataGridTextColumn Header="{StaticResource SummaryMismatch}" Binding="{Binding Mismatch}" Width="*" ElementStyle="{StaticResource SummaryValueText}" />
                            <DataGridTextColumn Header="{StaticResource SummaryFailed}" Binding="{Binding Failed}" Width="*" ElementStyle="{StaticResource SummaryValueText}" />
                            <DataGridTextColumn Header="{StaticResource SummaryExtras}" Binding="{Binding Extras}" Width="*" ElementStyle="{StaticResource SummaryValueText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{StaticResource SummaryTimes}" FontWeight="SemiBold" />
                        <TextBlock x:Name="SummaryTimeTextBlock" Grid.Column="1" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{StaticResource SummarySpeed}" FontWeight="SemiBold" />
                        <TextBlock x:Name="SummarySpeedFirstTextBlock" Grid.Column="1" />
                    </Grid>
                    <Grid Grid.Row="4" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{StaticResource SummarySpeed}" FontWeight="SemiBold" />
                        <TextBlock x:Name="SummarySpeedSecondTextBlock" Grid.Column="1" />
                    </Grid>
                    <Grid Grid.Row="5" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{StaticResource SummaryEnded}" FontWeight="SemiBold" />
                        <TextBlock x:Name="SummaryEndedTextBlock" Grid.Column="1" />
                    </Grid>
                </Grid>
                </Grid>
            </Grid>
        </Border>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock x:Name="FooterStatusTextBlock" Text="{StaticResource Ready}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
