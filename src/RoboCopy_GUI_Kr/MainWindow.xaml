<Window x:Class="RoboCopy_GUI_Kr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RoboCopy_GUI_Kr"
        Title="{StaticResource AppTitle}"
        Width="1080"
        Height="880"
        MinWidth="920"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1" Padding="24,16,20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="DigitalRhythmVisualLegacy" Grid.ColumnSpan="3" Height="54" Visibility="Collapsed"
                           Margin="335,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                           IsHitTestVisible="False" Opacity="0.58">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,224,54" ViewportUnits="Absolute"
