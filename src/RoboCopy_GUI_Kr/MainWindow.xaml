                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Viewbox x:Name="DigitalRhythmVisual" Grid.ColumnSpan="3" Height="54"
                         Margin="335,0,-20,-16" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                         Stretch="Fill" IsHitTestVisible="False" Opacity="0.64">
