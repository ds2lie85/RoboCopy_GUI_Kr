<Window x:Class="RoboCopy_GUI_Kr.MtBenchmarkHistoryWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource MtBenchmarkHistoryTitle}"
        Width="680" Height="440" MinWidth="560" MinHeight="340"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{StaticResource MtBenchmarkHistoryInstruction}"
                   Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />

        <DataGrid x:Name="HistoryDataGrid" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="None">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{StaticResource RemoveSelected}" Click="RemoveSelected_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{StaticResource MtBenchmarkThreadCount}" Binding="{Binding ThreadCount}" Width="*" />
                <DataGridTextColumn Header="{StaticResource MtBenchmarkAverageSpeed}" Binding="{Binding SpeedDisplay}" Width="2*" />
                <DataGridTextColumn Header="{StaticResource MtBenchmarkSampleCount}" Binding="{Binding SampleCount}" Width="*" />
                <DataGridTextColumn Header="{StaticResource MtBenchmarkTestedAt}" Binding="{Binding TestedAt}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryTextBlock" VerticalAlignment="Center"
                       Foreground="{StaticResource SubtleTextBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{StaticResource RemoveSelected}" Click="RemoveSelected_Click" />
                <Button Content="{StaticResource Close}" IsCancel="True" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
