<Window x:Class="RoboCopy_GUI_Kr.ContinuousSyncConflictWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RoboCopy_GUI_Kr"
        Title="{DynamicResource ContinuousSyncConflictTitle}"
        Width="920" Height="430" MinWidth="760" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource ContinuousSyncConflictHeading}" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap"
                   Text="{DynamicResource ContinuousSyncConflictDescription}" />
        <DataGrid x:Name="ConflictGrid" Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                  IsReadOnly="False" CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="None" SelectionMode="Extended" PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource ContinuousSyncUseCurrentTask}" Click="UseCurrentTask_Click" />
                    <MenuItem Header="{DynamicResource ContinuousSyncChangeSettings}" Click="ChangeSettings_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn ElementStyle="{StaticResource GridCheckBoxStyle}" EditingElementStyle="{StaticResource GridCheckBoxEditingStyle}" Header="{DynamicResource Select}" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="58" />
                <DataGridTextColumn Header="{DynamicResource ContinuousSyncConflictType}" Binding="{Binding Type}" Width="120" IsReadOnly="True" />
                <DataGridTemplateColumn Header="{DynamicResource SourceFolder}" Width="*" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:PathTextBlock FullPath="{Binding Source}" Padding="4,0" HorizontalAlignment="Stretch" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{DynamicResource DestinationFolder}" Width="*" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:PathTextBlock FullPath="{Binding Destination}" Padding="4,0" HorizontalAlignment="Stretch" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="{DynamicResource ContinuousSyncInterval}" Binding="{Binding Interval}" Width="110" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Button Content="{DynamicResource ContinuousSyncShowRegistered}" HorizontalAlignment="Left"
                    Click="ShowRegistered_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource ContinuousSyncUseSelected}" Click="UseSelected_Click" Style="{StaticResource PrimaryButton}" />
                <Button Content="{DynamicResource Cancel}" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
